{
  "title": "Проверка универсальности: система из ТРЁХ нелинейных уравнений",
  "variables": ["x1", "x2", "x3"],
  "constants": {},

  "F": [
    "x1**2 + x2**2 + x3**2 - 14",
    "x1 + x2 + x3 - 6",
    "x1*x2*x3 - 6"
  ],
  "J": [
    ["2*x1",  "2*x2",  "2*x3"],
    ["1",     "1",     "1"],
    ["x2*x3", "x1*x3", "x1*x2"]
  ],

  "epsilon": 1e-10,
  "max_iterations": 500,

  "region": [[0.5, 4.0], [0.5, 4.0], [0.5, 4.0]],
  "plot_region": [[0.5, 4.0], [0.5, 4.0], [0.5, 4.0]],
  "initial_guess": [0.8, 1.8, 3.4],
  "positive_solution_only": true,

  "epsilon_series": [1e-2, 1e-4, 1e-6, 1e-8, 1e-10]
}
